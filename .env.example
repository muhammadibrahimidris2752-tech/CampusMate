# ==============================================================================
# Nigerian Student Platform — Backend Environment Configuration
# ==============================================================================
# Copy this file to .env and fill in real values for your environment:
#     cp .env.example .env
#
# NEVER commit a real .env file — it is excluded in .gitignore.
# Production values must be provided through your deployment platform's
# secret manager, not through a committed file.
# ==============================================================================

# --- Application -------------------------------------------------------------
NODE_ENV=development
# development | test | staging | production
PORT=3000
APP_NAME="Nigerian Student Platform API"
API_GLOBAL_PREFIX=api
API_DEFAULT_VERSION=1
# Set true only when running behind a reverse proxy / load balancer
# (needed for correct client IPs in rate limiting and logs).
TRUST_PROXY=false
# OpenAPI (Swagger) docs at /api/docs. Defaults to off in production —
# override deliberately (and consider protecting the route) if you need it there.
ENABLE_SWAGGER=true

# --- CORS ----------------------------------------------------------------------
# Comma-separated list of allowed origins. Never use "*" in staging/production.
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:19006

# --- Rate limiting (@nestjs/throttler) ----------------------------------------
THROTTLE_TTL_MS=60000
THROTTLE_LIMIT=120

# --- PostgreSQL (primary source of truth) -------------------------------------
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_USERNAME=postgres
DATABASE_PASSWORD=postgres
DATABASE_NAME=nigerian_student_platform_dev
# Set true for most managed staging/production Postgres providers.
DATABASE_SSL=false
DATABASE_POOL_MAX=10
# Verbose SQL query logging — dev/debug only, never production.
DATABASE_LOGGING=false

# --- Redis (cache, rate-limit store, future job queues) -----------------------
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_TLS=false
REDIS_KEY_PREFIX=nsp:

# --- Object storage (S3-compatible) -------------------------------------------
# Foundation only in Phase 0A — no upload/download endpoints exist yet.
# Leave STORAGE_PROVIDER=none until the resource/PDF phase wires it up.
STORAGE_PROVIDER=none
# none | s3
STORAGE_ENDPOINT=
# Leave blank for AWS S3. Set for S3-compatible providers, e.g.
# https://nyc3.digitaloceanspaces.com or an internal MinIO endpoint.
STORAGE_REGION=us-east-1
STORAGE_BUCKET=
STORAGE_ACCESS_KEY_ID=
STORAGE_SECRET_ACCESS_KEY=
# true for most non-AWS S3-compatible providers.
STORAGE_FORCE_PATH_STYLE=false
STORAGE_PRESIGNED_URL_TTL_SECONDS=300

# --- Logging -------------------------------------------------------------------
LOG_LEVEL=debug
# fatal | error | warn | info | debug | trace
LOG_PRETTY=true
# Human-readable logs locally; leave unset (or false) in staging/production
# for structured JSON that log aggregators can parse.

# --- Reserved for a later phase (Identity & Authentication) -------------------
# Declared here only so the shape of the config is documented in advance.
# Nothing in Phase 0A reads these.
# JWT_ACCESS_SECRET=
# JWT_REFRESH_SECRET=
# JWT_ACCESS_TTL=15m
# JWT_REFRESH_TTL=30d

# --- Reserved for a later phase (Notifications via Firebase Cloud Messaging) --
# FCM_PROJECT_ID=
# FCM_CLIENT_EMAIL=
# FCM_PRIVATE_KEY=
